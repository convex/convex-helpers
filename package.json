    "usehooks-ts": "^3.1.0",
    "vite": "8.2.0",
    "vitest": "5.0.0",
    "yaml": "2.9.0",
    "zod": "^4.1",
    "zod-compare": "3.2.0",
    "zod3": "npm:zod@~3.25.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "./dist/*"
      ],
      "*": [
        "./dist/*"
      ]
    }
  }
}
